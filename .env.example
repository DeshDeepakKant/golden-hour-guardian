# ==============================================================================
# Golden Hour Guardian — Environment Configuration
# ==============================================================================

# LLM Providers (Choose one or use deterministic fallback)
# ------------------------------------------------------------------------------
# Anthropic Claude API Key (optional: falls back to deterministic templates if omitted)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Sarvam AI Key for Indic languages TTS/STT (optional)
SARVAM_API_KEY=your_sarvam_api_key_here

# Core Application & Storage Overrides
# ------------------------------------------------------------------------------
# GUARDIAN_DB=data/guardian.db
# GUARDIAN_LLM_MODEL=claude-3-5-sonnet-20241022

# Security & Containment Parameters
# ------------------------------------------------------------------------------
# GUARDIAN_HOLD_MAX_S=3600          # Max duration of temporary UPI hold (default: 60 mins)
# GUARDIAN_VERIFY_TIMEOUT_S=120     # Voice/App verification response window (default: 120s)
